# EquiScore — variáveis de ambiente. Cadastre estes valores na Vercel
# (Settings → Environment Variables). NÃO comite valores reais.

# Banco (MongoDB Atlas)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster/equiScore?retryWrites=true&w=majority

# Administrador criado no primeiro acesso
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Assina o cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Origens liberadas para a API (separe por vírgula)
ALLOWED_ORIGINS=https://sayoz.online

# Cloudflare R2 — armazena os PDFs gerados (S3 compatível)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://arquivos.seu-dominio.com
