# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).

# Mesmo banco do SAHDI — os dois sistemas convivem durante a migração.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster/banco?retryWrites=true&w=majority

# Chave que assina o cookie de sessão. Gere com: openssl rand -base64 48
SESSION_SECRET=
